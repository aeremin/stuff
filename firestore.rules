rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin(auth) {
      // email_verified only matters if a sign-in method other than Google
      // (which always verifies) is ever turned on.
      return auth != null
        && auth.token.email_verified == true
        && (auth.token.email == "a.eremin.msu@gmail.com" || auth.token.email == "j.lotova@gmail.com")
    }

    match /{document=**} {
      allow read, write: if isAdmin(request.auth)
    }
  }
}
