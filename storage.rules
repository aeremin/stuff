rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin(auth) {
      // `admin` is a custom claim, set by hand on the accounts that may use
      // the inventory. The Cloud Function checks the same claim
      // (functions/src/access.ts). email_verified only matters if a sign-in
      // method other than Google (which always verifies) is ever turned on.
      return auth != null
        && auth.token.email_verified == true
        && auth.token.admin == true
    }

    match /{allPaths=**} {
      allow read, write: if isAdmin(request.auth)
    }
  }
}
